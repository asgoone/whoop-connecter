{
  "mcp": {
    "servers": {
      "whoop": {
        "command": "/path/to/whoop-mcp-launcher",
        "connectionTimeoutMs": 15000,
        "requestTimeoutMs": 45000,
        "toolFilter": {
          "include": [
            "get_auth_status",
            "get_daily_summary",
            "get_recovery",
            "get_sleep",
            "get_workouts",
            "get_cycles",
            "get_trends",
            "get_body_measurement"
          ]
        },
        "codex": {
          "agents": ["coach"],
          "defaultToolsApprovalMode": "auto"
        }
      }
    }
  }
}
